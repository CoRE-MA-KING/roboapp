# https://just.systems

target := './include ./src -not -path "*/proto/*" -regex ".*\.\(c\|h\|cpp\|hpp\)$"'

target:
    find {{ target }} -type f;

deps:
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release

clang-tidy:
    run-clang-tidy -quiet -p ./build -header-filter='^(include|src)/(?!proto/)' '^src/(?!proto/).*' '^include/.*';

format:
    find {{ target }} -exec clang-format -i {} +;

format-check:
    find {{ target }} -exec clang-format --Werror --dry-run -i {} +;

build:
    cmake --build build --config Release

[working-directory: 'build']
test:
    ctest --output-on-failure

